RESOLVEFLOW_ENVIRONMENT=production
RESOLVEFLOW_DOCS_ENABLED=false
RESOLVEFLOW_TRUSTED_ORIGINS='["https://staging.invalid"]'
RESOLVEFLOW_CORS_ORIGINS='["https://staging.invalid"]'
RESOLVEFLOW_SESSION_HOURS=12
RESOLVEFLOW_REQUIRE_EMAIL_VERIFICATION=true
# Inject the loopback staging DSN and Valkey ACL URL into root-owned api.env.
# DATABASE_URL=
# RESOLVEFLOW_REDIS_URL=
RESOLVEFLOW_JOB_QUEUE=resolveflow-staging
RESOLVEFLOW_WORKER_CONCURRENCY=1
RESOLVEFLOW_INVITATION_DELIVERY=disabled
RESOLVEFLOW_EMAIL_DELIVERY=disabled
RESOLVEFLOW_EMAIL_PUBLIC_ORIGIN=https://staging.invalid
# Set smtp mode only after these values and sender DNS are verified.
RESOLVEFLOW_EMAIL_FROM=no-reply@example.com
RESOLVEFLOW_SMTP_HOST=smtp-relay.brevo.com
RESOLVEFLOW_SMTP_PORT=587
RESOLVEFLOW_SMTP_TLS=starttls
# RESOLVEFLOW_SMTP_USERNAME=
# RESOLVEFLOW_SMTP_PASSWORD=
RESOLVEFLOW_GOOGLE_ENABLED=false
RESOLVEFLOW_GOOGLE_REDIRECT_URI=https://staging.invalid/auth/google/callback
# RESOLVEFLOW_GOOGLE_CLIENT_ID=
# RESOLVEFLOW_GOOGLE_CLIENT_SECRET=
RESOLVEFLOW_AI_PROVIDER=gemini
RESOLVEFLOW_AI_LIVE_ENABLED=false
RESOLVEFLOW_AI_FREE_TIER_VERIFIED=false
RESOLVEFLOW_DOCUMENT_STORAGE_ROOT=/var/lib/resolveflow-staging/documents
RESOLVEFLOW_CLASSIFIER_ARTIFACT_ROOT=/var/lib/resolveflow-staging/models/classifier
RESOLVEFLOW_CLASSIFIER_MODEL_VERSION=baseline-v1
RESOLVEFLOW_EMBEDDING_MODEL_ROOT=/var/lib/resolveflow-staging/models/minilm-v1
RESOLVEFLOW_EMBEDDING_DEVICE=cpu
RESOLVEFLOW_ERASURE_JOURNAL_ROOT=/var/lib/resolveflow-staging/erasure-journal
RESOLVEFLOW_ERASURE_WITNESS_ROOT=/srv/resolveflow-staging-witness/commit-witness
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
PYTHONPATH=/opt/resolveflow-staging/apps/api/src
