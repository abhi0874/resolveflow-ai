[Unit]
Description=ResolveFlow staging RQ %i
PartOf=resolveflow-staging.target
After=network-online.target postgresql.service valkey-server.service

[Service]
User=resolveflow-staging
Group=resolveflow-staging
WorkingDirectory=/opt/resolveflow-staging/apps/api
EnvironmentFile=/etc/resolveflow-staging/api.env
ExecStart=/opt/resolveflow-staging/apps/api/.venv/bin/python scripts/jobs.py %i
Restart=on-failure
KillMode=mixed
TimeoutStopSec=150
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/resolveflow-staging/documents
