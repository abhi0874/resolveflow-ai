# Full application mode (default). Use .env.demo.example for the separate recruiter demo.
NEXT_PUBLIC_APP_MODE=full
DEMO_LIVE_AI_ENABLED=false

# Public browser configuration, never a place for secrets.
# Origin of the FastAPI server (no /api/v1 suffix). Restart Next.js after edits.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Server-only upstream for first-party authentication/workspace routing.
# Required for `next start`; never prefix this variable with NEXT_PUBLIC_.
API_INTERNAL_URL=http://127.0.0.1:8000
