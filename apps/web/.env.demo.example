# Safe demo-only configuration. No credentials or backend URLs required.
# Set at build AND startup; rebuild when switching application mode.
NEXT_PUBLIC_APP_MODE=demo
DEMO_LIVE_AI_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
# Public live inference is not enableable in this release.
# Do not add GEMINI_API_KEY, database URLs, or production session secrets.
