# Optional local overrides. Defaults work without this file.
RESOLVEFLOW_ENVIRONMENT=development
RESOLVEFLOW_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
RESOLVEFLOW_DOCS_ENABLED=true

# Server-only example. Replace placeholder credentials; never commit your .env.
# Missing configuration keeps /health usable but makes /ready return HTTP 503.
DATABASE_URL=postgresql+psycopg://resolveflow_dev:CHANGE_ME@127.0.0.1:55433/resolveflow_dev
RESOLVEFLOW_DB_POOL_SIZE=5
RESOLVEFLOW_DB_MAX_OVERFLOW=5
RESOLVEFLOW_DB_POOL_TIMEOUT=3
RESOLVEFLOW_DB_CONNECT_TIMEOUT=3
RESOLVEFLOW_DB_STATEMENT_TIMEOUT_MS=5000

# Exact browser origins permitted to mutate data. Production must use HTTPS.
RESOLVEFLOW_TRUSTED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
RESOLVEFLOW_SESSION_HOURS=12
# Production: RESOLVEFLOW_ENVIRONMENT=production forces Secure + __Host- cookies.

# Step 6 private storage. Optional absolute path; default is repo/.local/documents.
# RESOLVEFLOW_DOCUMENT_STORAGE_ROOT=/absolute/private/resolveflow-documents
RESOLVEFLOW_DOCUMENT_UPLOAD_MAX_BYTES=2097152
RESOLVEFLOW_DOCUMENT_MAX_PAGES=100
RESOLVEFLOW_DOCUMENT_MAX_CHARS=500000
RESOLVEFLOW_DOCUMENT_TIMEOUT_SECONDS=15
RESOLVEFLOW_DOCUMENT_MEMORY_MB=256
RESOLVEFLOW_DOCUMENT_CHUNK_SIZE=1200
RESOLVEFLOW_DOCUMENT_CHUNK_OVERLAP=150

# Step 7 trusted local data-only classifier artifact; train explicitly, never at startup.
# RESOLVEFLOW_CLASSIFIER_ARTIFACT_ROOT=/absolute/private/resolveflow-classifier
RESOLVEFLOW_CLASSIFIER_MODEL_VERSION=baseline-v1
RESOLVEFLOW_CLASSIFIER_THRESHOLD=0.45

# Local semantic embeddings: explicit download; runtime never downloads or calls a paid API.
# Default private root: repository .local/embeddings/minilm-v1
# RESOLVEFLOW_EMBEDDING_MODEL_ROOT=/absolute/private/embedding-model
RESOLVEFLOW_EMBEDDING_DEVICE=cpu
RESOLVEFLOW_EMBEDDING_BATCH_SIZE=16
RESOLVEFLOW_INDEXING_MAX_CHUNKS=256
RESOLVEFLOW_INDEXING_TIMEOUT_SECONDS=40
RESOLVEFLOW_SEARCH_MIN_SIMILARITY=0.30

# Step 9: cloud generation is OFF by default. Never place this key in web environment files.
# GEMINI_API_KEY=configure_privately_on_the_server_only
RESOLVEFLOW_AI_PROVIDER=gemini
RESOLVEFLOW_AI_MODEL=gemini-3.6-flash
# Use "default" to omit thinking configuration for a model that lacks these levels.
RESOLVEFLOW_GEMINI_THINKING_LEVEL=minimal
RESOLVEFLOW_AI_LIVE_ENABLED=false
RESOLVEFLOW_AI_FREE_TIER_VERIFIED=false
# Operator allowlist of synthetic-only workspace UUIDs; real customer workspaces stay excluded.
RESOLVEFLOW_AI_SYNTHETIC_WORKSPACES=[]
RESOLVEFLOW_AI_TIMEOUT_SECONDS=25
RESOLVEFLOW_AI_MAX_RETRIES=0
RESOLVEFLOW_AI_MAX_CALLS=1
RESOLVEFLOW_AI_CONCURRENCY=2
RESOLVEFLOW_AI_DAILY_GLOBAL=20
RESOLVEFLOW_AI_DAILY_WORKSPACE=10
RESOLVEFLOW_AI_DAILY_USER=5
RESOLVEFLOW_AI_CONTEXT_CHARS=6000
RESOLVEFLOW_AI_TICKET_CHARS=4000
RESOLVEFLOW_AI_TOP_K=4
RESOLVEFLOW_AI_MAX_OUTPUT_TOKENS=1024

# LangGraph execution bounds; never enables live inference.
RESOLVEFLOW_WORKFLOW_CONCURRENCY=2
RESOLVEFLOW_WORKFLOW_TIMEOUT_SECONDS=60
RESOLVEFLOW_WORKFLOW_MAX_ATTEMPTS=3
RESOLVEFLOW_WORKFLOW_DAILY_USER=20

# Step 11: local_broker.py setup appends the authenticated URL to private .env.
# RESOLVEFLOW_REDIS_URL=redis://:PRIVATE_PASSWORD@127.0.0.1:56379/0
RESOLVEFLOW_JOB_QUEUE=resolveflow-workflows
RESOLVEFLOW_WORKER_CONCURRENCY=1
RESOLVEFLOW_JOB_WORKSPACE_CONCURRENCY=1
RESOLVEFLOW_JOB_TIMEOUT_SECONDS=120
RESOLVEFLOW_JOB_MAX_ATTEMPTS=3
RESOLVEFLOW_JOB_QUEUE_CAPACITY=50
RESOLVEFLOW_JOB_MAX_PENDING=100
RESOLVEFLOW_JOB_WORKSPACE_PENDING=10
RESOLVEFLOW_JOB_RECONCILE_SECONDS=5
